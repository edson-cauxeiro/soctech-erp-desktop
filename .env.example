# =============================================================================
# DoraERP — Variáveis de Ambiente
# =============================================================================

NODE_ENV=development
DATABASE_URL=postgresql://doraerp_user:doraerp_secret@localhost:5432/doraerp?schema=public
# Shadow database usada pelo `prisma migrate dev` (a role precisa de CREATEDB).
SHADOW_DATABASE_URL=postgresql://doraerp_user:doraerp_secret@localhost:5432/doraerp_shadow?schema=public
APP_SECRET=doraerp_secret_key_default_development_2026

# PostgreSQL (Docker)
POSTGRES_USER=doraerp_user
POSTGRES_PASSWORD=doraerp_secret
POSTGRES_DB=doraerp
POSTGRES_PORT=5432
